#!/bin/bash
# secret-guard — DAY-0 §3 and §5: no secrets, no binaries, no models.json in
# commits. Scans the staged diff when a git commit is attempted.
# Registered in .claude/settings.json (PreToolUse: Bash). Exit 2 blocks.
set -uo pipefail

INPUT=$(cat)
CMD=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
[ -z "$CMD" ] && exit 0

# Only act on git commit
echo "$CMD" | grep -Eq '(^|[;&|][[:space:]]*)git[[:space:]]+([^;|&]*[[:space:]])?commit([[:space:]]|$)' || exit 0

cd "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

block() {
  echo "BLOCKED (secret-guard, DAY-0 §3/§5): $1" >&2
  exit 2
}

STAGED_NAMES=$(git diff --cached --name-only 2>/dev/null || true)
[ -z "$STAGED_NAMES" ] && exit 0

# Machine-specific registry and binary artifacts never enter history
echo "$STAGED_NAMES" | grep -Eq '(^|/)models\.json$' \
  && block "models.json is machine-specific and gitignored; it must not be committed."
echo "$STAGED_NAMES" | grep -Eq '\.(exe|dylib|so|a|o|gguf|bin|zip|tar|tgz|gz|7z|dmg|pkg)$' \
  && block "a binary/archive artifact is staged: $(echo "$STAGED_NAMES" | grep -E '\.(exe|dylib|so|a|o|gguf|bin|zip|tar|tgz|gz|7z|dmg|pkg)$' | head -3 | tr '\n' ' ')"
git diff --cached --numstat 2>/dev/null | grep -q "^-	-	" \
  && block "a binary file is staged (git reports it as binary): $(git diff --cached --numstat | grep "^-	-	" | cut -f3 | head -3 | tr '\n' ' ')"

# Secret patterns in staged content (added lines only), excluding the
# legitimate api_key_env reference pattern.
SECRETS=$(git diff --cached 2>/dev/null | grep -E '^\+' | grep -v 'api_key_env' | grep -nE \
  -e '-----BEGIN [A-Z ]*PRIVATE KEY' \
  -e 'AKIA[0-9A-Z]{16}' \
  -e '(ghp|gho|ghu|ghs)_[A-Za-z0-9]{36,}' \
  -e 'github_pat_[A-Za-z0-9_]{20,}' \
  -e 'xox[baprs]-[A-Za-z0-9-]{10,}' \
  -e 'sk-[A-Za-z0-9_-]{20,}' \
  -e '(api[_-]?key|apikey|auth[_-]?token|secret|password)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9+/_-]{16,}["'"'"']' \
  | head -5 || true)
[ -n "$SECRETS" ] && block "staged content matches secret patterns:
$SECRETS
Remove the secret (reference it by environment-variable name instead) before committing."

exit 0
