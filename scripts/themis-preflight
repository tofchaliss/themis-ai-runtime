#!/bin/bash
# themis-preflight — host readiness for a Themis AI Runtime deployment.
#
# Read-only. Creates nothing, changes nothing, contacts nothing except a
# local model endpoint if one is configured. Safe to run repeatedly.
#
# Why this exists: several of this repository's evidence-producing tests
# SKIP rather than fail when the host is not what they expect — git at an
# unprobed path, no model endpoint, running as root. A skipped proof
# reports green. This script makes those conditions visible BEFORE you
# read a green suite as evidence.
#
# Usage:  scripts/themis-preflight [--deploy DIR]
#   --deploy DIR   also check capacity/permissions for a deployment root
#
# Exit: 0 all checks pass (warnings allowed), 1 one or more FAIL.
set -uo pipefail

DEPLOY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --deploy) DEPLOY="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

PASS=0; WARN=0; FAIL=0
ok()   { printf '  \033[32mPASS\033[0m  %s\n' "$*"; PASS=$((PASS+1)); }
warn() { printf '  \033[33mWARN\033[0m  %s\n' "$*"; WARN=$((WARN+1)); }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; FAIL=$((FAIL+1)); }
note() { printf '        %s\n' "$*"; }
sec()  { printf '\n\033[1m%s\033[0m\n' "$*"; }

printf '\033[1mThemis AI Runtime — host preflight\033[0m\n'
printf 'date: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

# ---------------------------------------------------------------- host
sec "Host"
OS=$(uname -s); ARCH=$(uname -m); KERNEL=$(uname -r)
note "os=$OS arch=$ARCH kernel=$KERNEL host=$(hostname)"
case "$OS" in
  Linux)  CPUS=$(nproc 2>/dev/null || echo '?')
          MEMKB=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
          MEMGB=$((MEMKB/1024/1024)) ;;
  Darwin) CPUS=$(sysctl -n hw.ncpu 2>/dev/null || echo '?')
          MEMGB=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024/1024/1024 )) ;;
  *)      CPUS='?'; MEMGB=0 ;;
esac
note "cpus=$CPUS memory=${MEMGB}GB"
[ "$CPUS" != "?" ] && [ "$CPUS" -lt 4 ] 2>/dev/null \
  && warn "only $CPUS vCPU — the suite drives several packages at the model concurrently" \
  || ok "cpu count adequate ($CPUS)"
if [ "$MEMGB" -gt 0 ] && [ "$MEMGB" -lt 8 ]; then
  bad "${MEMGB}GB RAM — too little to hold a 7B model and build concurrently"
else
  ok "memory present (${MEMGB}GB)"
fi
# Contention is about CONCURRENCY, not host size. Nine live proofs
# across nine packages drive ONE model server; go test runs packages in
# parallel, so they queue behind each other and time out. Measured on
# two very different hosts, both failing:
#   16GB / 8-core / Metal      — context proofs fail in the sweep
#   62GB / 24-core / CPU-only  — SIX live proofs fail in the sweep,
#                                every one passing alone minutes earlier
# An earlier version of this script warned below 32GB, inferring a memory
# threshold from the first host alone. The second host disproved it: more
# memory and 3x the cores made it worse, because parallelism is the
# mechanism. No host size fixes this; scheduling does.

# identity: root silently voids permission-based fixtures
if [ "$(id -u)" = "0" ]; then
  bad "running as root — permission-based fixtures SKIP and their controls go unproven"
  note "affected: TestEgressPersistenceFailure, TestSealedWorkspaceReadOnly,"
  note "TestTeardownAnomalous (both subtests). Run the suite as a normal user."
else
  ok "running as non-root (uid $(id -u)) — permission fixtures will execute"
fi

# ------------------------------------------------------------ toolchain
sec "Toolchain"
if command -v go >/dev/null 2>&1; then
  GOV=$(go version | awk '{print $3}' | sed 's/^go//')
  MAJ=${GOV%%.*}; REST=${GOV#*.}; MIN=${REST%%.*}
  if [ "${MAJ:-0}" -gt 1 ] 2>/dev/null || { [ "${MAJ:-0}" -eq 1 ] && [ "${MIN:-0}" -ge 24 ]; } 2>/dev/null; then
    ok "go $GOV (module requires 1.24+)"
  else
    bad "go $GOV is below the 1.24 required by src/harness/go.mod"
  fi
else
  bad "go not found on PATH"
fi

# git: the harness pins the ABSOLUTE path, and the test helpers probe
# exactly two locations. Elsewhere and the governed-chain tests skip.
if command -v git >/dev/null 2>&1; then
  GITPATH=$(command -v git); GITV=$(git --version | awk '{print $3}')
  note "git $GITV at $GITPATH"
  if [ -x /usr/bin/git ] || [ -x /opt/homebrew/bin/git ]; then
    ok "git present at a probed path — governed-chain tests will run"
    [ "$GITPATH" != "/usr/bin/git" ] && [ "$GITPATH" != "/opt/homebrew/bin/git" ] \
      && note "PATH git ($GITPATH) differs from the probed one; tests use the probed path"
  else
    bad "git is not at /usr/bin/git or /opt/homebrew/bin/git"
    note "test helper gitBin() probes only those two paths and calls t.Skip otherwise,"
    note "so execution, integration, orchestration and verification/seam would SKIP"
    note "SILENTLY — the entire governed-chain proof would vanish from a green run."
  fi
  note "record this absolute path: the Deployment Anchor host config pins it"
else
  bad "git not found — required at runtime, not only to build"
fi

# fixtures added for bounded-termination proofs need a shell and sleep
for b in sh sleep; do
  if command -v "$b" >/dev/null 2>&1; then ok "$b present ($(command -v $b))"
  else bad "$b not found — termination fixtures (group-kill, mid-drain) would skip"; fi
done

# ---------------------------------------------------------------- model
sec "Model endpoint"
OLLAMA="${THEMIS_LIVE_OLLAMA:-http://localhost:11434}"
note "endpoint=$OLLAMA (override with THEMIS_LIVE_OLLAMA)"
TAGS=$(curl -fsS --max-time 5 "$OLLAMA/api/tags" 2>/dev/null)
if [ -z "$TAGS" ]; then
  warn "no model endpoint reachable — every live proof will SKIP (CI-equivalent)"
  note "that is a clean state, not an error: the suite stays hermetic."
  note "But live proofs then produce NO evidence; the operationally-proven"
  note "verdict requires a named local execution with a recorded model."
else
  ok "model endpoint reachable"
  # Acceleration decides WHERE inference contends. With a GPU, inference
  # and the Go suite use different silicon. CPU-only, they fight for the
  # same cores — a contention axis memory size says nothing about, and
  # the one that actually applies on a GPU-less server.
  ACCEL="cpu-only"
  if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
    ACCEL="nvidia"
  elif [ -e /dev/kfd ]; then
    ACCEL="amd-rocm"
  elif [ "$OS" = "Darwin" ] && [ "$ARCH" = "arm64" ]; then
    ACCEL="metal"
  fi
  if [ "$ACCEL" = "cpu-only" ]; then
    warn "inference is CPU-ONLY — it competes with the suite for the same cores"
    note "no NVIDIA/AMD GPU detected. Every live proof's model turns will run on"
    note "the same $CPUS cores the test suite is using, so a full sweep contends"
    note "on CPU regardless of how much memory this host has."
    note "Consequences to plan around, not fix:"
    note "  - live proofs take substantially longer; turn_timeout_sec and the"
    note "    ceiling's max_wall_deadline_sec must accommodate real turn latency"
    note "  - a large model (~20B) may be impractical here: roughly 3x a 7B per"
    note "    turn, which multi-turn walks multiply again"
    note "  - prefer running live proofs SEPARATELY from the full sweep"
  else
    ok "inference acceleration: $ACCEL — inference does not contend for suite cores"
  fi
  MODELS=$(printf '%s' "$TAGS" | python3 -c 'import sys,json;print(" ".join(m["name"] for m in json.load(sys.stdin).get("models",[])))' 2>/dev/null)
  note "models: ${MODELS:-<none>}"
  # live proofs are ENDPOINT-gated, not opt-in: if this answers, they run.
  TOOLM="${THEMIS_LIVE_TOOL_MODEL:-qwen2.5:7b}"
  CONVM="${THEMIS_LIVE_MODEL:-WhiteRabbitNeo/WHiteRabbitNeo-2.5-Qwen-2.5-Coder-7B:latest}"
  for pair in "THEMIS_LIVE_TOOL_MODEL:$TOOLM" "THEMIS_LIVE_MODEL:$CONVM"; do
    var=${pair%%:*}; want=${pair#*:}
    if printf '%s' " $MODELS " | grep -q " $want "; then
      ok "$var model present: $want"
    else
      bad "$var model MISSING: $want"
      note "the endpoint answers, so live proofs RUN and will fail on this model."
      note "fix: ollama pull $want   (or point $var at a model you have)"
    fi
  done
  # Endpoint reachable AND modest memory: live proofs will run and will
  # contend. Say so, because the green line above would otherwise imply
  # a full-sweep pass is meaningful evidence on this host.
  warn "do NOT run the full suite with live proofs enabled"
  note "The endpoint answers, so live proofs RUN. Nine of them, across nine"
  note "packages that go test executes in PARALLEL, all driving this ONE model"
  note "server. They queue behind each other and time out. This is not a host"
  note "capacity question: it reproduces on 16GB/8-core/Metal AND on"
  note "62GB/24-core/CPU-only, where it is worse because more parallelism"
  note "means more simultaneous callers."
  note ""
  note "Run the suite hermetic, then the live proofs separately:"
  note "  THEMIS_LIVE_OLLAMA=http://127.0.0.1:9 go test ./... -count=1"
  note "  go test ./context/ -run 'TestLiveOperationalProof|TestLivePressureProof' -count=1"
  note "  go test ./verification/seam/ -run TestLiveRemediateWalk -count=1"
  note "  go test ./ratchet/ -run TestLiveModelAuthorsCandidate -count=1"
  note "  go test ./tools/ -run TestLiveToolProof -count=1"
  note "  go test ./execution/ -run TestLiveExecutionProof -count=1"
  note "  go test ./state/ -run TestLiveTaskReconstruction -count=1"
  note "  go test ./orchestration/ -run 'TestLiveWalkProof|TestLiveSkillWalk' -count=1"
  note ""
  note "A full-sweep live failure is NOT evidence of a defect."
  note "A live proof that fails IN ISOLATION is a real failure."
fi

# ------------------------------------------------- delegation templates
# C-L8-14 F: every registered delegation template's manifest bytes must
# match its registry pin, and every pin inside the manifest must match
# its file. A drifted file is not a "changed template": the template
# becomes unavailable (fail closed) and reconstruction keeps the stored
# bytes. Read-only.
sec "Delegation templates"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DREG="$ROOT/policies/delegation/registry.json"
if [ ! -f "$DREG" ]; then
  warn "no delegation-template registry at $DREG"
elif ! command -v python3 >/dev/null 2>&1 || ! command -v shasum >/dev/null 2>&1; then
  warn "python3 or shasum missing — cannot verify template pins"
else
  DRES=$(python3 - "$DREG" <<'PY'
import hashlib, json, os, sys
reg = sys.argv[1]; root = os.path.dirname(reg)
def sha(p):
    with open(p, "rb") as f: return hashlib.sha256(f.read()).hexdigest()
try:
    entries = json.load(open(reg))["entries"]
except Exception as e:
    print(f"FAIL registry unreadable: {e}"); sys.exit(0)
for e in entries:
    ref = f'{e["name"]}@{e["version"]}'
    mp = os.path.join(root, e["manifest_path"])
    if not os.path.isfile(mp):
        print(f"FAIL {ref}: manifest missing at {e['manifest_path']}"); continue
    if sha(mp) != e["template_sha256"]:
        print(f"FAIL {ref}: manifest bytes do not match the registry pin"); continue
    m = json.load(open(mp)); mdir = os.path.dirname(mp); bad = False
    for member in ("context_contract", "instruction"):
        pin = m.get(member)
        if not pin: continue
        fp = os.path.join(mdir, pin["path"])
        if not os.path.isfile(fp) or sha(fp) != pin["sha256"]:
            print(f"FAIL {ref}: {member} bytes do not match the manifest pin"); bad = True
    if not bad:
        print(f"PASS {ref} ({e['state']}): manifest and every pin verified")
PY
)
  if [ -z "$DRES" ]; then warn "registry lists no templates"; fi
  note "delegation_template_registry pin: $(shasum -a 256 "$DREG" | cut -d' ' -f1)"
  # here-string, not a pipe: the PASS/FAIL counters must survive the loop
  while IFS= read -r line; do
    case "$line" in
      PASS*) ok "${line#PASS }" ;;
      FAIL*) bad "${line#FAIL }" ;;
      "") ;;
      *) note "$line" ;;
    esac
  done <<< "$DRES"
fi

# ----------------------------------------------------- themis store
# D-T-9: the two registries must load under their closed schemas and
# the pin is what an anchor's themis_store field must equal.
sec "Themis store"
TDIR="$ROOT/policies/themis"
if [ ! -f "$TDIR/findings.json" ] || [ ! -f "$TDIR/products.json" ]; then
  warn "no Themis store at $TDIR"
else
  TPIN=$(cat "$TDIR/findings.json" "$TDIR/products.json" | shasum -a 256 | cut -d' ' -f1)
  note "themis_store pin: $TPIN"
  if python3 - "$TDIR" <<'PY'
import json, sys, re
d = sys.argv[1]
p = json.load(open(d + "/products.json")); f = json.load(open(d + "/findings.json"))
ids = {e["id"] for e in p["entries"]}
bad = [e["id"] for e in f["entries"] if e.get("product") not in ids or not re.match(r"^FIND-", e["id"])]
sys.exit(1 if bad else 0)
PY
  then ok "findings reference registered products ($(python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))["entries"]))' "$TDIR/findings.json") findings, $(python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))["entries"]))' "$TDIR/products.json") products)"
  else bad "a finding references an unregistered product or has a bad id"; fi
fi

# ----------------------------------------------------------- deployment
if [ -n "$DEPLOY" ]; then
  sec "Deployment root: $DEPLOY"
  if [ -d "$DEPLOY" ]; then
    ok "exists"
    [ -w "$DEPLOY" ] && ok "writable" || bad "not writable by $(id -un)"
    PERM=$(stat -c '%a' "$DEPLOY" 2>/dev/null || stat -f '%Lp' "$DEPLOY" 2>/dev/null)
    [ "$PERM" = "700" ] && ok "mode 700" || warn "mode $PERM — the runbook uses 700"
  else
    warn "does not exist yet (runbook Step 3 creates it)"
  fi
  TARGET="$DEPLOY"; [ -d "$TARGET" ] || TARGET=$(dirname "$DEPLOY")
  if [ -d "$TARGET" ]; then
    AVAIL=$(df -Pk "$TARGET" 2>/dev/null | awk 'NR==2{print int($4/1024/1024)}')
    note "free space at $TARGET: ${AVAIL}GB"
    [ "${AVAIL:-0}" -lt 20 ] 2>/dev/null \
      && warn "under 20GB free — mirrors, state and artifacts all live here" \
      || ok "disk space adequate (${AVAIL}GB)"
  fi
  case "$DEPLOY" in
    */src/harness*|*/policies/*) bad "deployment root is inside the repository — it must not be" ;;
  esac
fi

# --------------------------------------------------------------- verdict
sec "Summary"
printf '  %d pass, %d warn, %d fail\n' "$PASS" "$WARN" "$FAIL"
if [ "$FAIL" -gt 0 ]; then
  printf '\n\033[31mNot ready.\033[0m Resolve the FAIL items above; each one either blocks\n'
  printf 'the build or silently removes evidence from an otherwise green suite.\n'
  exit 1
fi
printf '\n\033[32mHost is ready.\033[0m Next: runbook Step 2 (checkout and gate the build).\n'
[ "$WARN" -gt 0 ] && printf 'Warnings do not block, but record them — they change what a green run means.\n'
exit 0
